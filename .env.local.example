# Supabase — required for auth + live data (the UI runs on mock data without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (route handlers / admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Email — Resend. Powers replies sent to customers from Customer Support.
# Use the SAME key and sending domain as the budgetiq website, so replies come
# from the address customers already have. Without a key the Reply button still
# appears but every send fails with a clear message rather than silently.

RESEND_API_KEY=

# Must be on a domain verified in Resend, or every send is rejected.
EMAIL_FROM=BudgetIQ <info@budgetiq.org>

# General inbox.
TEAM_INBOX=info@budgetiq.org

# Customer support mailbox. Ticket replies are sent from it and customers'
# answers come back to it (Reply-To).
SUPPORT_EMAIL_FROM=BudgetIQ Support <support@budgetiq.org>
SUPPORT_INBOX=support@budgetiq.org
